# Copie para .env (fora do Git) e preencha.

# --- Supabase Realtime (AGENTES-REALTIME.22; tabela da seção .11 da ETAPA-040) ---
# URL pública do projeto AULAS SENAI: não é segredo. O publicador e o config.js já a trazem como
# padrão; defina aqui só para apontar para outro projeto.
SUPABASE_URL=https://hxlvonriearllcmfqeri.supabase.co
# Chave publicável (sb_publishable_…): pública por desenho, vai para o navegador. Vem da .12
# AGENTES-REALTIME.12 (o usuário cadastra); o valor de verdade fica em CANAL.chavePublicavel do
# assets/js/config.js, e esta variável só alimenta o medidor testes/medir_latencia.mjs.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY (sb_secret_…): NUNCA aqui nem em qualquer arquivo versionado. Ela só existe
# no secret SUPABASE_SECRET_KEY do GitHub (Gelvazio/rules-ai); o publicador não lê .env.
