# Copie para .env (fora do Git) e preencha.
# Chave da API da Tripo: https://platform.tripo3d.ai (API Keys). Começa com "tsk_".
TRIPO_API_KEY=
# Máximo de gerações por execução do servidor (cada uma custa 10 a 20 créditos = US$ 0,10 a 0,20).
LIMITE_GERACOES=5
# Atraso (segundos) entre a mudança no tasks/STATUS.md e a animação em agentes.html.
ATRASO_AGENTES=30
