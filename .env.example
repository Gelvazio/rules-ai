# Modelo do arquivo de variáveis de ambiente. Só NOMES, nunca valores secretos.
# Copie para `.env` (ignorado pelo Git) ou defina no ambiente do sistema.

# --- DeepSeek (INTEGRACAO-DEEPSEEK): chave só no ambiente, nunca em arquivo versionado ---
DEEPSEEK_API_KEY=
# `off` desliga a chamada à API (rollback); vazio = ligado
DEEPSEEK_MODO=
# Teto de tokens por chamada (padrão 2000)
DEEPSEEK_MAX_TOKENS=2000
# Limite de custo por dia, em dólares (padrão 2; aplicado pela subtarefa .4)
DEEPSEEK_MAX_CUSTO_DIA=2
